# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
DATABASE_NAME=ecommerce

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=just-another-project-secret
JWT_EXPIRY=7d

# CORS
CORS_ORIGIN=https://matches-gods-matters-compiled.trycloudflare.com/

# Account email: OTP verification, customer invitations, and password reset links.
# Copy these settings into .env and use credentials from your SMTP provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# false for port 587 (STARTTLS); true for port 465 (TLS).
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
# Use a sender address verified with your email provider.
MAIL_FROM="MXSoCal <no-reply@mxsocal.com>"
# Public frontend URL used in invitation and password reset links.
FRONTEND_URL=http://localhost:3000

# Cloudinary (for image uploads)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_KEY=your_cloudinary_key
CLOUDINARY_SECRET=your_cloudinary_secret

# Receives contact form and new footer contact notifications. Also used by seed-admin.js.
ADMIN_EMAIL=admin@example.com
