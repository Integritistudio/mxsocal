# Add these settings to your local .env. Do not commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
FRONTEND_URL=http://localhost:3000
# Set JWT_SECRET to a cryptographically random value of at least 32 bytes.
# Changing it invalidates existing links and sessions. Production rejects weak secrets.
